{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "__UUID__",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.github.com:443",
          "xver": 0,
          "serverNames": [
            "www.github.com",
            "www.google.com",
            "registry-1.docker.io"
          ],
          "privateKey": "__PRIVATE_KEY__",
          "shortIds": [
            "__SHORT_ID__"
          ]
        },
        "xhttpSettings": {
          "mode": "packet-up",
          "host": "github.com",
          "path": "/"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "domain": ["www.google.com"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["www.github.com"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["registry-1.docker.io"],
        "outboundTag": "direct"
      }
    ]
  }
}
